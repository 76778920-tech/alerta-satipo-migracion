{
  "name": "alerta-satipo-migracion",
  "version": "0.2.0",
  "private": true,
  "description": "Copia local preparada para migrar hosting y base de datos",
  "scripts": {
    "build": "node scripts/build.mjs",
    "configure": "node --env-file-if-exists=.env scripts/configure.mjs",
    "dataset": "python scripts/prepare_dataset.py",
    "api-data": "python -m acquisition",
    "capture:environment": "node --env-file-if-exists=.env scripts/capture-environment.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p \"*_test.py\"",
    "start": "python scripts/serve.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2"
  }
}
