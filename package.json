{
  "name": "alerta-satipo-migracion",
  "version": "0.2.0",
  "private": true,
  "description": "Copia local preparada para migrar hosting y base de datos",
  "scripts": {
    "build": "node scripts/build.mjs",
    "configure": "node --env-file-if-exists=.env scripts/configure.mjs",
    "dataset": "python scripts/prepare_dataset.py",
    "api-data": "python -m acquisition",
    "capture:environment": "node --env-file-if-exists=.env scripts/capture-environment.mjs",
    "import:dataset": "node --env-file-if-exists=.env scripts/import-dataset.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p \"*_test.py\"",
    "test:browser": "python tests/browser_hexagonal.py",
    "start": "python scripts/serve.py",
    "start:api": "node --env-file-if-exists=.env backend/server.mjs",
    "build:api": "node scripts/build-api.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2"
  }
}
